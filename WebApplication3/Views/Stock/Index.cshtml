@model List<WebApplication3.Models.StockBalance>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Остатки на складе
            </h2>

            <p class="text-muted mb-0">
                Контроль складских остатков и операций
            </p>
            <a href="/Stock/Report" class="btn btn-secondary mb-3">
                Ведомость
            </a>
        </div>

        <div class="d-flex gap-2">

            <a href="/Stock/Receipt"
               class="btn btn-success">

                Поступление

            </a>

            <a href="/Stock/Transfer"
               class="btn btn-primary">

                Перемещение

            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="table table-hover table-bordered align-middle mb-0">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>

                        <th>Товар</th>

                        <th>Артикул</th>

                        <th>Партия</th>

                        <th>Годен до</th>

                        <th>Срок годности</th>

                        <th>Количество</th>

                        <th>Резерв</th>

                        <th>Доступно</th>

                        <th>Мин. остаток</th>

                        <th>Статус остатка</th>

                        <th width="220">
                            Операции
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="12"
                                class="text-center p-4">

                                Остатков нет

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var available =
                                item.Quantity -
                                item.ReservedQuantity;

                            string rowClass = "";

                            string stockStatus = "ОК";

                            string stockBadgeClass =
                                "bg-success";

                            string expirationStatus =
                                "Без срока";

                            string expirationBadge =
                                "bg-secondary";

                            if (item.ProductBatch?.ExpirationDate != null)
                            {
                                var daysLeft =
                                    (item.ProductBatch.ExpirationDate.Value.Date -
                                     DateTime.Today).Days;

                                if (daysLeft < 0)
                                {
                                    expirationStatus =
                                        "ПРОСРОЧЕН";

                                    expirationBadge =
                                        "bg-danger";

                                    rowClass =
                                        "table-danger";
                                }
                                else if (daysLeft <= 7)
                                {
                                    expirationStatus =
                                        $"Истекает через {daysLeft} дн.";

                                    expirationBadge =
                                        "bg-warning text-dark";

                                    if (string.IsNullOrEmpty(rowClass))
                                    {
                                        rowClass =
                                            "table-warning";
                                    }
                                }
                                else
                                {
                                    expirationStatus =
                                        $"Годен ({daysLeft} дн.)";

                                    expirationBadge =
                                        "bg-success";
                                }
                            }

                            if (item.Product != null)
                            {
                                if (item.Quantity <
                                    item.Product.MinStock)
                                {
                                    stockStatus =
                                        "МАЛО НА СКЛАДЕ";

                                    stockBadgeClass =
                                        "bg-danger";

                                    rowClass =
                                        "table-danger";
                                }
                                else if (item.Quantity ==
                                         item.Product.MinStock)
                                {
                                    stockStatus =
                                        "МИНИМУМ";

                                    stockBadgeClass =
                                        "bg-warning text-dark";

                                    if (string.IsNullOrEmpty(rowClass))
                                    {
                                        rowClass =
                                            "table-warning";
                                    }
                                }
                            }

                            <tr class="@rowClass">

                                <td>
                                    @item.Id
                                </td>

                                <td>
                                    <strong>
                                        @item.Product?.Name
                                    </strong>
                                </td>

                                <td>
                                    @item.Product?.Article
                                </td>

                                <td>
                                    @item.ProductBatch?.BatchNumber
                                </td>

                                <td>

                                    @if (item.ProductBatch?.ExpirationDate != null)
                                    {
                                        @item.ProductBatch.ExpirationDate.Value.ToString("dd.MM.yyyy")
                                    }

                                </td>

                                <td>

                                    <span class="badge @expirationBadge">

                                        @expirationStatus

                                    </span>

                                </td>

                                <td>

                                    <span class="fw-bold">

                                        @item.Quantity


                                    </span>

                                </td>

                                <td>
                                    @item.ReservedQuantity
                                </td>

                                <td>

                                    <span class="fw-bold">

                                        @available

                                    </span>

                                </td>

                                <td>
                                    @item.Product?.MinStock
                                </td>

                                <td>

                                    <span class="badge @stockBadgeClass">

                                        @stockStatus

                                    </span>

                                </td>

                                <td>

                                    <div class="d-flex gap-2 flex-wrap">

                                        <a href="/Stock/WriteOff/@item.Id"
                                           class="btn btn-danger btn-sm">

                                            Списание

                                        </a>
                                        <a href="/Stock/Reserve/@item.Id"
                                           class="btn btn-warning btn-sm">

                                            Резерв

                                        </a>
                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Удалить остаток?');">

                                            <button class="btn btn-outline-danger btn-sm">
                                                Удалить
                                            </button>

                                        </form>
                                        

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>