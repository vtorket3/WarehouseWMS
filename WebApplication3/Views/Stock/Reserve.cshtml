@model WebApplication3.Models.ReserveViewModel

<div class="container mt-4">

    <h2>Резервирование товара</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <form method="post">

        <input asp-for="StockBalanceId"
               type="hidden" />

        <div class="mb-3">

            <label class="form-label">
                Количество для резерва
            </label>

            <input asp-for="Quantity"
                   class="form-control"
                   type="number"
                   step="0.01" />

        </div>

        <div class="mb-3">

            <label>Ответственный</label>

            <input asp-for="ResponsiblePerson"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Причина
            </label>

            <textarea asp-for="Reason"
                      class="form-control"></textarea>

        </div>

        <button type="submit"
                class="btn btn-warning">

            Зарезервировать

        </button>

        <a href="/Stock"
           class="btn btn-secondary">

            Назад

        </a>

    </form>

</div>